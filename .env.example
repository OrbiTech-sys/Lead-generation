# OrbiTech Lead Intelligence — environment variables
# Copy to .env.local (local dev) or set in your host. NOTHING here is required to run the app.
# Keys are read server-side only and are never sent to the browser.

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty for local development: an embedded Postgres (PGlite) is used and stored in ./.data/pglite.
# For production use a real PostgreSQL (docker compose sets this for you):
# DATABASE_URL=postgres://leads:change-me@localhost:5432/leads
#
# Max pooled connections to PostgreSQL (default 10).
# DATABASE_POOL_MAX=10
#
# Optional: where PGlite stores data, or "memory" for a throw-away in-memory database.
# PGLITE_DIR=

# --- Discovery sources (all optional) -------------------------------------------
# Google Places API (New). Billed by Google per request — see docs/INTEGRATIONS.md.
# Without it the Google source shows "needs API key" and is skipped; OpenStreetMap needs no key.
GOOGLE_MAPS_API_KEY=

# OpenStreetMap Overpass mirrors, comma-separated, tried in order. Use ONLY mirrors with global data
# (regional instances such as overpass.osm.ch silently return nothing elsewhere). Self-hosting is best for volume.
# OVERPASS_ENDPOINTS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter

# Nominatim geocoder. The public instance has a 1 request/second policy, which the app honours.
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Network identity -----------------------------------------------------------
# Sent to OpenStreetMap services. Public OSM servers refuse User-Agents that look like scrapers (e.g. containing "bot").
# API_USER_AGENT=OrbiTechLeadIntelligence/0.1 (https://theorbitechsolution.com)
# Sent when visiting business websites. Deliberately transparent; robots.txt rules for "OrbiTechLeadBot" are honoured.
# CRAWLER_USER_AGENT=OrbiTechLeadBot/0.1 (+https://theorbitechsolution.com/bot)

# --- Verification ---------------------------------------------------------------
# Extra disposable-email domains to reject, comma-separated (a small built-in list is always used).
# DISPOSABLE_EMAIL_DOMAINS=

# --- Docker compose only --------------------------------------------------------
# POSTGRES_PASSWORD=change-me
